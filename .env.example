# Exemplo de Variáveis de Ambiente para Produção / Vercel
# NUNCA insira senhas reais neste arquivo comitado.
# Configure as variáveis abaixo diretamente no painel da Vercel (Project Settings > Environment Variables).

# Conexão com o banco de dados PostgreSQL / Neon
VITE_DATABASE_URL=postgresql://seu_usuario:sua_senha@ep-exemplo.c-2.sa-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Chave de API Google Generative AI (Gemini) para indexação inteligente
VITE_GEMINI_API_KEY=sua_gemini_api_key_aqui
