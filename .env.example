# ==============================================================================
# Scalasystem / Antigravity Repositório Digital - Variáveis de Ambiente
# ==============================================================================
# NUNCA insira senhas e segredos reais neste arquivo comitado no repositório.
# Configure as variáveis abaixo no painel de deploy (ex: Vercel / Netlify / Render)
# ou no arquivo .env local protegido.

# 1. Banco de Dados PostgreSQL Serverless (Neon)
DATABASE_URL=postgresql://neondb_owner:senha@ep-exemplo.sa-east-1.aws.neon.tech/neondb?sslmode=require
VITE_DATABASE_URL=postgresql://neondb_owner:senha@ep-exemplo.sa-east-1.aws.neon.tech/neondb?sslmode=require

# 2. Neon Auth / URL de Autenticação
VITE_NEON_AUTH_URL=https://oauth.neon.tech/oauth/v2

# 3. Google Gemini AI (Indexação Inteligente e Extração de Metadados Serverless)
# IMPORTANTE: Em produção, GEMINI_API_KEY deve ser configurada estritamente no backend/serverless
GEMINI_API_KEY=sua_gemini_api_key_aqui
VITE_GEMINI_API_KEY=sua_gemini_api_key_aqui

# 4. Storage de Arquivos Seguro (S3-Compatible / Antigravity Cloud Storage)
STORAGE_BUCKET_URL=https://storage.antigravity.io/scalasystem-acervo
STORAGE_ACCESS_KEY=seu_storage_access_key
STORAGE_SECRET_KEY=seu_storage_secret_key
